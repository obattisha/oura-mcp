/**
 * Secrets (set with `npx wrangler secret put <NAME>`):
 *   OURA_CLIENT_SECRET                  - from your Oura API application
 *   COOKIE_ENCRYPTION_KEY               - any random string, e.g. `openssl rand -hex 32`
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "oura-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "1d06beb00eb74cccaf5a08df66d051a9"
		}
	],
	"vars": {
		// Only this Oura account may sign in. Must match the email on your Oura account.
		"ALLOWED_OURA_EMAIL": "obattisha@gmail.com",
		// Not secret; the client secret is set in the dashboard.
		"OURA_CLIENT_ID": "f8413fdb-3d35-41d7-a525-013f63a017fd"
	},
	// Optional: serve on mcp.battisha.com instead of *.workers.dev. Requires battisha.com's
	// DNS to be managed by Cloudflare (see README).
	// "routes": [{ "pattern": "mcp.battisha.com", "custom_domain": true }],
	"observability": { "enabled": true },
	"dev": { "port": 8788 }
}
